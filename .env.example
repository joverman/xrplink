# Network: coston2 or flare
FLARE_NETWORK=coston2

# Coston2 test wallet private key (funded with test FLR from faucet)
PRIVATE_KEY_COSTON2=

# Flare mainnet wallet private key (fund with real FLR)
PRIVATE_KEY_FLARE=

# Flare verifier API key
VERIFIER_API_KEY=

# Deployed PaymentVerifier contract address (auto-selected by FLARE_NETWORK)
PAYMENT_VERIFIER_ADDRESS_COSTON2=
PAYMENT_VERIFIER_ADDRESS_FLARE=

# API server port
PORT=3000

# MCP SSE transport port (for remote agent connections)
MCP_SSE_PORT=3001

# Polling config
MAX_POLL_ATTEMPTS=6
POLL_INTERVAL_MS=30000

# x402 pay-per-attestation (XRPL facilitator). Do not put wallet secrets here.
# X402_PAY_TO_ADDRESS is the XRPL classic address that receives XRP/RLUSD.
X402_ENABLED=true
X402_PAY_TO_ADDRESS=
XRPL_FACILITATOR_URL=https://xrpl-facilitator-mainnet.t54.ai
XRPL_NETWORK=xrpl:0
X402_RLUSD_ISSUER=
X402_FLOOR_USD=0.50
X402_MARKUP=3
ATTESTATION_FEE_FLR=20
X402_PRICE_CACHE_TTL_MS=300000
