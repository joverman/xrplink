# Network: coston2 or flare
FLARE_NETWORK=coston2

# Coston2 test wallet private key (funded with test FLR from faucet)
PRIVATE_KEY_COSTON2=

# Flare mainnet wallet private key (fund with real FLR)
PRIVATE_KEY_FLARE=

# Flare verifier API key
VERIFIER_API_KEY=

# Deployed PaymentVerifier contract address (auto-selected by FLARE_NETWORK)
PAYMENT_VERIFIER_ADDRESS_COSTON2=
PAYMENT_VERIFIER_ADDRESS_FLARE=

# API server port
PORT=3000

# MCP SSE transport port (for remote agent connections)
MCP_SSE_PORT=3001

# Polling config
MAX_POLL_ATTEMPTS=6
POLL_INTERVAL_MS=30000

# Mainnet attestation quotas per billing period (Free stays 0)
# ATTESTATION_LIMIT_FREE=0
# ATTESTATION_LIMIT_PAID=20
# ATTESTATION_LIMIT_PRO=100

# x402 pay-per-attestation (XRPL facilitator). Do not put wallet secrets here.
# X402_PAY_TO_ADDRESS is the single XRPL classic address that receives XRP/RLUSD.
# That wallet must already hold an RLUSD trust line to the issuer below.
X402_ENABLED=true
X402_PAY_TO_ADDRESS=
XRPL_FACILITATOR_URL=https://xrpl-facilitator-mainnet.t54.ai
XRPL_NETWORK=xrpl:0
# Defaults: mainnet rMxCKbEDwqr76QuheSUMdEGf4B9xJ8m5De, testnet rQhWct2fv4Vc4KRjRgMrxa8xPN9Zx9iLKV
X402_RLUSD_ISSUER=
X402_FLOOR_USD=2.50
X402_MARKUP=3
X402_CAP_USD=10.00
X402_PRICE_STEP_USD=0.25
X402_XRP_BUFFER=0.01
ATTESTATION_FEE_FLR=20
X402_PRICE_REFRESH_MS=60000
X402_PRICE_MAX_AGE_MS=300000
X402_QUOTE_TTL_MS=120000
# X402_KRAKEN_TICKER_URL=https://api.kraken.com/0/public/Ticker?pair=FLRUSD,XRPUSD
